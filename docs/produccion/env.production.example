APP_NAME="MVS Commerce"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.mvscommerce.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CR
APP_TIMEZONE=America/Costa_Rica

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Objetivo cloud aprobado: PostgreSQL privado, nunca expuesto a Internet.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mvs_commerce
DB_USERNAME=mvs_commerce
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=app.mvscommerce.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Sustituir por el proveedor SMTP aprobado antes de activar correo real.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@mvscommerce.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
